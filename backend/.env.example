# Backend .env configuration template
# Copy this file to .env and adjust for your environment

# Database Configuration
DATABASE_URL=postgresql://user:password@db:5432/inventory_db

# For production with managed PostgreSQL:
# DATABASE_URL=postgresql://username:password@hostname.db.onrender.com:5432/database_name

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# For production with deployed frontend:
# FRONTEND_URL=https://your-frontend-domain.vercel.app

# Debug Mode (set to False in production)
DEBUG=True

# For production
# DEBUG=False
